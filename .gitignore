# 模型与运行时资产（体积大，不入库）
models/*
# 例外：GTCRN 工厂噪声降噪模型 523 KiB（sherpa-onnx 官方 Apache-2.0 预训练），
# 体积小且服务默认启用，整包随仓库分发免去首次部署单独拉取。
# 下载源：https://github.com/k2-fsa/sherpa-onnx/releases/tag/speech-enhancement-models
# 注：unignore 必须同时打开父目录链（models/ -> models/asr/），否则父目录的忽略会级联屏蔽子文件；
#     且 models/asr/* 会把其余大模型（zipfer/silero_vad）继续屏蔽，仅放行 gtcrn 一个文件。
!models/asr/
models/asr/*
!models/asr/gtcrn_simple.onnx

# VC++ Redistributable 安装包（第三方二进制，随部署包带，不入库）
vc_redist.x64.exe

# 构建产物
bin/
obj/
publish/

# Cordova 安卓壳构建产物与依赖（源码只留 config.xml/package.json/build.ps1/www）
cordova/platforms/
cordova/plugins/
cordova/node_modules/

# 测试项目构建产物（tests/*.cs 源码仍入库，仅排除 bin/obj 防 xunit/fluentassertions 二进制污染仓库）
tests/bin/
tests/obj/

# 本地环境变量（含密钥）
.env

# 本地 HTTPS 证书（自签、绑定 IP；用 make-cert.bat 重新生成，私钥不入库）
certs/
wwwroot/ca.crt

# 日志
*.log

.kilo/
