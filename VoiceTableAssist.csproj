<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>VoiceTableAssist</AssemblyName>
    <RootNamespace>VoiceTableAssist</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceTableAssist.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 服务托管：Windows 服务 / systemd（按运行平台选其一） -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <!-- 进程内 RaNER / gte-base-zh 推理（onnxruntime native 随目标 RID 提供） -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot 随编译拷入输出目录：ContentRoot 固定为 exe 目录、生产模式不加载
         静态资源清单，从 bin 直接运行时验证页 /voice-mic.js 等才可访问 -->
    <Content Remove="wwwroot\**" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- assets/** 是随代码走的运行时小资源（表内读音吸附的拼音字典），必须拷到输出目录：
         老版本部署的 models/ 里没有 hr_char_pinyin.txt，git 拉取后直接替换程序文件即可运行 -->
    <Content Remove="assets\**" />
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- tests/** 由 VoiceTableAssist.Tests 单独编译；避免主项目 SDK 把测试文件纳入自身 Compile 列表 -->
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- 相关文档/** 内含安卓化方案的原生工程与 .NET 示例源码（非本服务代码），禁止纳入编译 -->
    <Compile Remove="相关文档\**" />
    <Content Remove="相关文档\**" />
    <None Remove="相关文档\**" />
    <!-- models/** 是大体积模型资源（raner + embedding），仅运行时从发布目录读取，禁止编译期拷入输出目录 -->
    <Content Remove="models\**" />
    <None Include="models\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <!-- 涉密前端 front/** 绝不入发布包（Web SDK 默认把 **/*.json 当 Content，会漏带 front/config.json 等） -->
    <Content Remove="front\**" />
    <None Remove="front\**" />
    <!-- 本机发布产物/运行期数据同样不入包（publish-linux 里含 models 与旧 publish 副本，曾随包外泄） -->
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <Content Remove="publish-linux\**" />
    <None Remove="publish-linux\**" />
    <Content Remove="backup\**" />
    <None Remove="backup\**" />
    <!-- 证书不入包：平板走 Cordova 壳内 http://localhost 安全上下文，不需要 HTTPS 证书 -->
    <Content Remove="wwwroot\ca.crt" />
    <Content Remove="xj-apk\**" />
    <None Remove="xj-apk\**" />
    <Content Remove="logs\**" />
    <None Remove="logs\**" />
    <!-- global.json 只用于构建期锁 SDK 版本，不需要随包分发 -->
    <Content Remove="global.json" />
    <None Remove="global.json" />
    <!-- sherpa-onnx/** 原生可执行 + ASR 模型 + hr 语音资源，由 publish.ps1 随发布目录拷贝，禁止编译期拷入 -->
    <Content Remove="sherpa-onnx\**" />
    <None Include="sherpa-onnx\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
