{
  "Urls": "http://0.0.0.0:15232",
  "AsrProvider": {
    "Denoise": {
      "_comment": "GTCRN 进程内 PCM 降噪（工厂噪声场景）。已实现流式 STFT/ISTFT 并实测（RMS -25.7%），默认关闭；工厂噪声现场置 true 启用。详见 部署文档.md 'GTCRN 降噪' 一节。",
      "Enabled": false,
      "ModelPath": "models/asr/gtcrn_simple.onnx",
      "NumThreads": 1,
      "SampleRate": 16000
    }
  },
  "Interaction": {
    "SilenceMs": 300,
    "MaxChars": 500
  },
  "Models": {
    "LazyLoad": true,
    "IdleUnloadSeconds": 180
  },
  "Embedding": {
    "MinSim": 0.55
  },
  "SherpaServer": {
    "_comment": "sherpa-onnx 进程内识别（P/Invoke）：识别器常驻、热词按流传入，无子进程/端口/热词文件（server exe 已从包中移除）。ModelingUnit 默认 cjkchar（对齐安卓）；本仓库模型无 bpe.model，需 bbpe 时须同时配 BpeVocab=<bpe.model 路径>，否则服务端拒绝加载。",
    "NativeDir": "models/sherpa-onnx",
    "Encoder": "models/asr/sherpa-onnx-streaming-zipformer-zh-2025-06-30/encoder.onnx",
    "Decoder": "models/asr/sherpa-onnx-streaming-zipformer-zh-2025-06-30/decoder.onnx",
    "Joiner": "models/asr/sherpa-onnx-streaming-zipformer-zh-2025-06-30/joiner.onnx",
    "Tokens": "models/asr/sherpa-onnx-streaming-zipformer-zh-2025-06-30/tokens.txt",
    "DecodingMethod": "modified_beam_search",
    "ModelingUnit": "cjkchar",
    "BpeVocab": "",
    "Provider": "cpu",
    "NumThreads": 4,
    "MaxActivePaths": 4,
    "HotwordsScore": 2.0,
    "ExpectedNativeVersion": "1.13.6",
    "SampleRate": 16000,
    "EnableEndpoint": true,
    "Rule1TrailingSilence": 2.0,
    "Rule2TrailingSilence": 2.0,
    "Rule3TrailingSilence": 2.0
  },
  "Tables": {
    "BaseDir": "embedding/tables",
    "HrBaseDir": "sherpa-onnx/hr/tables",
    "HrCurrentDir": "sherpa-onnx/hr/tables/current",
    "DefaultTable": "default",
    "IdleTimeout": "00:30:00",
    "IdleCheckInterval": "00:01:00"
  },
  "Align": {
    "_comment": "表内读音吸附（SoundAligner）：行标签+列说法自动构成词表，按读音吸附纠错，零人工规则。Threshold=采纳阈值，Margin=与次优候选的最小差距（分不清则放弃）。CharPinyin 默认取随代码发布的 assets/（老版本 models/ 里没有也能跑）；指向 models/sherpa-onnx/hr/hr_char_pinyin.txt 亦可。",
    "CharPinyin": "assets/hr_char_pinyin.txt",
    "Threshold": 0.75,
    "Margin": 0.15
  },
  "Logging": {
    "RetentionDays": 30,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}