// Android.bp —— Soong 构建（设备端正式形态：stub APK 内嵌 native service）
//
// 依赖前置：
//   1. sherpa-onnx 源码 v1.12.x 放到本目录 third_party/sherpa-onnx（自带 Android.bp 可直接引入，
//      或按其官方文档生成 prebuilt）。此处以 prebuilt 静态库占位：
//      third_party/prebuilt/libsherpa-onnx.a + 头文件 jni/third_party/sherpa-onnx/include
//   2. onnxruntime-android ≥ 1.28.0（方案 §14.4：钉死版本，防新 SoC 静默算错）
//      third_party/onnxruntime/jni/arm64-v8a/libonnxruntime.so + headers/
//
// 产物：libvta-service.so（stub APK jniLibs 加载）+ AIDL Java 桩（自动生成，不手写）
//
// 注：aidl 模块用 ndk backend 生成 C++ 桩；Java backend 由同一组 .aidl 自动产出
//     com.vta.IVtaService / PcmFrame / SessionState / TableInfo / CellHit 的 Java 类，
//     企业 App 直接以 java_libs 依赖本模块的 java 输出（或拷贝生成物）。

aidl_interface {
    name: "com.vta.service",
    local_include_dir: "aidl",
    // 接口仍在演进期（方案 §9.2 多处【待定】），用 unstable 免 frozen 版本管理
    unstable: true,
    srcs: [
        "aidl/com/vta/IVtaService.aidl",
        "aidl/com/vta/PcmFrame.aidl",
        "aidl/com/vta/SessionState.aidl",
        "aidl/com/vta/TableInfo.aidl",
        "aidl/com/vta/CellHit.aidl",
    ],
    backend: {
        ndk: { enabled: true },
        java: { enabled: true },   // 企业 App 侧依赖（自动生成，业务侧不写 Java）
        cpp: { enabled: false },
    },
}

cc_library_static {
    name: "vta_core",
    srcs: [
        "jni/common/*.cc",
        "jni/text/*.cc",
        "jni/embed/*.cc",
        "jni/homophone/*.cc",
        "jni/ner/*.cc",
        "jni/denoise/*.cc",
        "jni/asr/*.cc",
        "jni/tables/*.cc",
        "jni/session/*.cc",
        "jni/service/*.cc",
    ],
    // main.cc 单独给 binary；so 形态由 stub APK 的 Java service 通过 JNI_OnLoad 拉起时
    // 也要 main 之外的全部源码（见 vta-service 静态库引用）
    exclude_srcs: ["jni/service/main.cc"],
    local_include_dirs: ["jni"],
    // AIDL NDK backend 生成物（头 + Bn/Bp 桩）
    static_libs: [
        "com.vta.service_ndk",
        "libonnxruntime_vta",
        "libsherpa_onnx_vta",
    ],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libaaudio",
    ],
    cflags: ["-Wall", "-Wextra"],
    stl: "c++_static",
}

cc_binary {
    name: "vta-service",
    srcs: ["jni/service/main.cc"],
    whole_static_libs: ["vta_core"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libaaudio",
        "libonnxruntime_vta",
    ],
    stl: "c++_static",
}

// ---- prebuilts（路径按实际解包位置调整）----
cc_prebuilt_library_static {
    name: "libsherpa_onnx_vta",
    srcs: ["third_party/prebuilt/arm64-v8a/libsherpa-onnx.a"],
    export_include_dirs: ["third_party/sherpa-onnx/include"],
}

cc_prebuilt_library_shared {
    name: "libonnxruntime_vta",
    srcs: ["third_party/onnxruntime/jni/arm64-v8a/libonnxruntime.so"],
    export_include_dirs: ["third_party/onnxruntime/headers"],
}
